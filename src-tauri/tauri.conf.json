{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Intentio Tasks",
  "version": "1.7.0",
  "identifier": "com.intentio.tasks",
  "build": {
    "beforeDevCommand": "npm run start",
    "devUrl": "http://localhost:1422",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist/int-tasks/browser"
  },
  "app": {
    "windows": [
      {
        "title": "Intentio Tasks",
        "width": 1100,
        "height": 760,
        "minWidth": 420,
        "minHeight": 480
      }
    ],
    "security": {
      "csp": null
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IENERjhDRjQ2OTMxODAyNDQKUldSRUFoaVRScy80emNWMmdHcVY2cnZhKzFCVzJNcTlpSjJTRVpHYjA4OHpDcFppQTZGSmdXam0K",
      "endpoints": [
        "https://github.com/intentio-software/int-tasks/releases/latest/download/latest.json"
      ]
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": "v1Compatible",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
